# RustFS TLS terminates here; RustFS listeners remain local plain HTTP.
upstream rustfs_s3 { server 127.0.0.1:{{ rustfs_api_address.split(':')[-1] }}; }
upstream rustfs_console { server 127.0.0.1:{{ rustfs_console_address.split(':')[-1] }}; }
server {
    listen {{ rustfs_nginx_listen_port }} ssl;
    server_name {{ rustfs_nginx_s3_server_name }};
    ssl_certificate {{ rustfs_nginx_ssl_certificate }};
    ssl_certificate_key {{ rustfs_nginx_ssl_certificate_key }};
    client_max_body_size 0;
    proxy_request_buffering off;
    location / {
        proxy_pass http://rustfs_s3;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_http_version 1.1;
    }
}
server {
    listen {{ rustfs_nginx_listen_port }} ssl;
    server_name {{ rustfs_nginx_console_server_name }};
    ssl_certificate {{ rustfs_nginx_ssl_certificate }};
    ssl_certificate_key {{ rustfs_nginx_ssl_certificate_key }};
    location / {
        proxy_pass http://rustfs_console;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }
}
